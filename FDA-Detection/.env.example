# ==========================================
# FDA Detection System - Environment Config (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก API Key ก่อนสั่งรัน
# ==========================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fda_detection
DATABASE_URL=postgresql://postgres:postgres@db:5432/fda_detection

# Roboflow Model Configuration (Package Detection Fallback)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace_here
ROBOFLOW_PROJECT_ID=package-fl0a2
ROBOFLOW_VERSION=1

# Typhoon OCR Configuration (Vision-LLM for Thai OCR)
# สมัครรับ API Key ได้ที่: https://opentyphoon.ai/
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_ENDPOINT=https://api.opentyphoon.ai/v1/chat/completions
TYPHOON_MODEL=typhoon-ocr

# Hugging Face Token (สำหรับดาวน์โหลดโมเดล Grounding DINO / SAM)
# สมัครและสร้าง Read Token ได้ที่: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Python Path
PYTHONPATH=./backend
